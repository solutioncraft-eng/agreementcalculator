# PostgreSQL connection string used at runtime.
# On Supabase use the transaction pooler (port 6543) so serverless functions
# don't exhaust connections: ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://calc:password@localhost:5432/agreementcalculator?schema=public"

# Unpooled connection used only for migrations (pgbouncer can't run DDL).
# On Supabase this is the direct/session connection on port 5432.
DIRECT_URL="postgresql://calc:password@localhost:5432/agreementcalculator?schema=public"

# Session signing key — random, at least 32 characters (openssl rand -base64 48)
AUTH_SECRET=""

# Absolute base URL used in notification emails
APP_BASE_URL="http://localhost:3000"

# Build stamp printed on every exported PDF. Set to the deployed commit SHA.
APP_BUILD=""

# Bootstrap administrator, used by `npm run db:seed` only
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Workspace Administrator"
SEED_ADMIN_PASSWORD=""

# Email notifications. Resend is preferred; with neither Resend nor SMTP the app
# falls back to the in-app review queue.
RESEND_API_KEY=""
EMAIL_FROM="Agreement Calculator <noreply@agreementcalculator.com>"

# Optional SMTP, used only when RESEND_API_KEY is unset.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Agreement Calculator <noreply@agreementcalculator.com>"

# Google sign-in. With either unset the "Continue with Google" button is hidden
# and password sign-in is the only way in. Create an OAuth 2.0 Web application
# client in Google Cloud Console and register exactly this redirect URI:
#   <APP_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional allow-list of email domains that may use Google, comma separated
# (e.g. "solutioncraft.ai,acme.com"). Empty means any Google account that
# already has an account here.
GOOGLE_ALLOWED_DOMAINS=""

# Root hostname tenants are subdomains of, e.g. agreementcalculator.com.
# Defaults to the host in APP_BASE_URL.
APP_ROOT_DOMAIN=""

# Search engine ownership verification, rendered as <meta> tags on every page.
# Google: Search Console → Add property (URL prefix) → "HTML tag"; paste the
# token or the whole tag. Bing: Webmaster Tools → "HTML Meta Tag". Leave empty
# to emit nothing.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# Seed workspace created by `npm run db:seed`
SEED_TENANT_SLUG="demo"
SEED_TENANT_NAME="Demo Workspace"

# Stripe subscription billing. With any of these unset the paywall is inert:
# the app keeps working on trials and operator activation, and the Subscribe
# button explains that card payment is not switched on.
# Use test keys (sk_test_…) until the flow has been exercised end to end.
STRIPE_SECRET_KEY=""
# Recurring price the workspace subscribes to (price_…, $69/month).
STRIPE_PRICE_ID=""
# Signing secret of the endpoint that receives /api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=""

# Tenant logo uploads (Supabase Storage). Without these, administrators can
# still point branding at an image URL they host themselves.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_LOGO_BUCKET="tenant-logos"

# Help → Support & requests files tickets with Foundry (SolutionCraft's
# ticketing app). Per-application HMAC credential issued by Foundry; with either
# unset, a bearer intake key (fk_…) is used instead; with none of them the
# form is replaced by a note that support is not switched on.
FOUNDRY_CLIENT_ID=""
FOUNDRY_SIGNING_SECRET=""
FOUNDRY_INTAKE_KEY=""
# Override only when Foundry moves; defaults to the production tickets-intake URL.
FOUNDRY_INTAKE_URL=""
