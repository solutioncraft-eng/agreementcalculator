// Agreement Calculator — multi-tenant data model
//
// Two constraints shape this schema:
//
//  1. Calculator *results* are not stored. A quote is persisted only when an
//     account manager deliberately submits it for leadership review
//     (QuoteRequest); everything else is calculated and discarded. Audit
//     trail, pricing versions and PDF export stamps are kept permanently.
//
//  2. Every tenant-owned row carries `tenantId`, including rows that could
//     reach their tenant through a parent. Queries never have to join to
//     filter, and the scoped Prisma client in src/lib/db.ts can inject the
//     filter for every model in one place.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL is the pooled connection used at runtime (Supabase transaction
// pooler, port 6543). DIRECT_URL bypasses the pooler for DDL — migrations and
// introspection cannot run through pgbouncer. Locally both point at the same
// database.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Role within a single tenant. Held on Membership, not User, so one person
/// can be an account manager in one workspace and a leader in another.
enum Role {
  ADMIN
  LEADER
  AM
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

/// How a tenant turns cost into a sell rate. Chosen when the workspace is
/// created and locked once a pricing version is published.
enum PricingModel {
  COST_PLUS
  MARKUP_MULTIPLE
}

enum Unit {
  USER
  DEVICE
  LOCATION
  FLAT
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuoteStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  DENIED
  WITHDRAWN
}

enum ReviewAction {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  DENIED
  WITHDRAWN
  COMMENTED
  RESUBMITTED
}

enum ExportDocType {
  QUOTE
  COGS
}

/// A customer workspace. `slug` is the subdomain it is reached on.
model Tenant {
  id     String       @id @default(cuid())
  slug   String       @unique
  name   String
  status TenantStatus @default(TRIAL)

  /// Locked once a pricing version is published; only a super admin can change it.
  pricingModel PricingModel @default(COST_PLUS)

  /// When the free trial stops. Set for workspaces that signed themselves up;
  /// null means there is no deadline, which is how an operator-created
  /// workspace and every paying one behave.
  trialEndsAt DateTime?

  // ── Branding ─────────────────────────────────────────────────────
  /// Public URL of the tenant's uploaded logo. Falls back to the product mark.
  logoUrl     String?
  accentColor String?
  pdfFooter   String?

  /// Months a submitted quote is retained before purge.
  retentionMonths Int @default(12)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  pricingVersions PricingVersion[]
  serviceTiers    ServiceTier[]
  cogsItems       CogsItem[]
  bundles         BundleDiscount[]
  quoteRequests   QuoteRequest[]
  reviews         QuoteReview[]
  exports         ExportRecord[]
  auditEvents     AuditEvent[]
}

/// One login per person across the whole product; tenant access is granted by
/// Membership rows. `isSuperAdmin` is the product operator, not a tenant role.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean   @default(false)
  active       Boolean   @default(true)
  mustReset    Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships      Membership[]
  auditEvents      AuditEvent[]
  quoteRequests    QuoteRequest[]   @relation("submitter")
  reviews          QuoteReview[]
  exports          ExportRecord[]
  publishedVersion PricingVersion[] @relation("publisher")
  createdVersions  PricingVersion[] @relation("creator")
}

model Membership {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role   @default(AM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
}

/// An immutable-once-published snapshot of every number that drives a quote.
/// Quotes and PDF exports pin the version they were produced with so any
/// historical document can be reproduced exactly.
model PricingVersion {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Human label, e.g. "2026.3". Unique within the tenant.
  label  String
  status VersionStatus @default(DRAFT)
  /// Free-text cost basis shown on documents, e.g. "Q3 2026".
  costBasis String
  notes     String?

  /// Which pricing model produced this version, and its settings. The settings
  /// shape differs per model and is validated with the model's zod schema
  /// (src/lib/pricing/models); storing it as JSON keeps the table from growing
  /// a column set per model.
  model    PricingModel
  settings Json

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  createdById   String
  createdBy     User    @relation("creator", fields: [createdById], references: [id])
  publishedById String?
  publishedBy   User?   @relation("publisher", fields: [publishedById], references: [id])

  serviceTiers  ServiceTier[]
  cogsItems     CogsItem[]
  bundles       BundleDiscount[]
  quoteRequests QuoteRequest[]
  exports       ExportRecord[]

  @@unique([tenantId, label])
  @@index([tenantId, status])
}

/// A service level a workspace sells, e.g. "Advantage" then "Pinnacle". Tiers
/// are ordered and cumulative: a quote for the third tier includes the COGS
/// items of the first two, and each tier above the first is priced with the
/// add-on multiplier. They belong to a pricing version rather than the tenant
/// so publishing freezes the offering set along with the numbers, and a
/// historical quote keeps reproducing the tiers it was priced against.
model ServiceTier {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionId String
  version   PricingVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  /// Stable machine key, unique within a version; referenced by CogsItem.tierKey.
  key String
  /// Tenant-facing name, e.g. "Advantage".
  label String
  /// One line describing what the tier is, shown on the calculator card.
  description String?
  /// Position in the ladder. The lowest is the base tier everything builds on.
  sortOrder Int @default(0)

  @@unique([versionId, key])
  @@index([versionId])
  @@index([tenantId])
}

/// A cost of goods sold line: a tool the MSP pays for, allocated to a unit
/// basis (per user / per device / per location / flat per agreement).
model CogsItem {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionId String
  version   PricingVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  /// Stable machine key, unique within a version. Carried across versions so
  /// a line item's history can be followed.
  key       String
  label     String
  vendor    String?
  unit      Unit
  /// ServiceTier.key within the same version this item belongs to.
  tierKey   String
  unitCost  Decimal @db.Decimal(10, 4)
  /// Sell price per unit, used by rate-card style models. Null for cost-plus.
  unitPrice Decimal? @db.Decimal(10, 4)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([versionId, key])
  @@index([versionId])
  @@index([tenantId])
}

model BundleDiscount {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionId String
  version   PricingVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  key         String
  label       String
  description String?
  /// Discount as a percentage off the agreement rate.
  discountPct Decimal @db.Decimal(5, 2)
  highlight   Boolean @default(false)
  sortOrder   Int     @default(0)

  @@unique([versionId, key])
  @@index([tenantId])
}

/// Only created when a calculation trips an approval threshold and the AM
/// submits it for review. Holds the inputs and the computed rate so leadership
/// reviews the same numbers the AM saw.
model QuoteRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Short human reference, e.g. "QR-202603-8F3K". Unique within the tenant.
  ref    String
  status QuoteStatus @default(PENDING)

  clientName String
  notes      String?

  // Inputs
  users           Int
  devices         Int
  locations       Int
  sgmPct          Decimal @db.Decimal(5, 2)
  perUserFloor    Decimal @db.Decimal(10, 2)
  floorOverride   Boolean @default(false)
  addonMultiplier Decimal @db.Decimal(6, 2)
  markupMultiple  Decimal @db.Decimal(6, 2)
  bundleKey        String
  /// ServiceTier.key the account manager asked leadership to approve.
  requestedTierKey String

  /// Every tier's computed rate at submission time — what leadership signs off
  /// on — as [{ key, label, rate, perUser }], ordered as the ladder was then.
  /// Stored rather than recomputed so the review shows the numbers the account
  /// manager saw, and reads correctly even if the version is later archived.
  tierRates Json
  /// Named approval triggers active at submission, e.g. ["SGM_NON_DEFAULT"].
  triggers  String[]

  pricingVersionId String
  pricingVersion   PricingVersion @relation(fields: [pricingVersionId], references: [id])

  submittedById String
  submittedBy   User   @relation("submitter", fields: [submittedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  decidedAt DateTime?
  /// Retention: quote requests are purged after this date.
  purgeAfter DateTime

  reviews QuoteReview[]
  exports ExportRecord[]

  @@unique([tenantId, ref])
  @@index([tenantId, status])
  @@index([submittedById])
}

model QuoteReview {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quoteId  String
  quote    QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  action    ReviewAction
  comment   String?
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id])
  createdAt DateTime     @default(now())

  @@index([quoteId])
  @@index([tenantId])
}

/// One row per generated PDF. This is what makes "we know exactly how and when
/// this PDF was created" verifiable: the stamp printed on the document
/// (exportId + UTC timestamp + pricing version + app version) is looked up here.
model ExportRecord {
  id       String        @id @default(cuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Printed on the PDF, e.g. "EXP-8F3K2D". Unique across the product.
  exportId String        @unique
  docType  ExportDocType

  exportedById String
  exportedBy   User   @relation(fields: [exportedById], references: [id])

  pricingVersionId String
  pricingVersion   PricingVersion @relation(fields: [pricingVersionId], references: [id])
  /// Application version at the time of export.
  appVersion String

  quoteId String?
  quote   QuoteRequest? @relation(fields: [quoteId], references: [id])

  clientName String?
  /// Approval state stamped on the document.
  approvalState String
  /// Inputs the document was rendered from — no computed result is stored here
  /// for unflagged quotes; see docs/DATA_RETENTION.md.
  inputs Json?
  /// SHA-256 of the generated PDF bytes.
  checksum String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([exportedById])
}

model AuditEvent {
  id       String  @id @default(cuid())
  /// Null for events that happen before a tenant is known (failed sign-in) and
  /// for super-admin actions on the product itself.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  action   String
  /// Entity kind the action applied to, e.g. "CogsItem", "PricingVersion".
  entity   String?
  entityId String?
  summary  String
  before   Json?
  after    Json?

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])
  /// Preserved even if the user record is later removed.
  actorEmail String?

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}
